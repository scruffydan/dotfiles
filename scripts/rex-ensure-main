#!/usr/bin/env zsh
# Ensure the local Rex server has a terminal session named main.
set -eu
setopt pipefail

# Several panes can start their shells together. Release the lock on process exit.
lock_dir="${XDG_CACHE_HOME:-$HOME/.cache}/rex"
mkdir -p "$lock_dir"
touch "$lock_dir/ensure-main.lock"
zmodload zsh/system
zsystem flock "$lock_dir/ensure-main.lock"

has_main=$(rex api call session.list | jq -sr '
  if length == 1 and (.[0].sessions | type == "array") then
    any(.[0].sessions[]; .label == "main")
  else error("unexpected Rex session list") end
')
if [[ "$has_main" == false ]]; then
  rex session new main --cwd "$HOME" > /dev/null
fi
